generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  notes         Note[]
  memories      Memory[]
  documents     Document[]
  tasks         Task[]
  habits        Habit[]
  studySessions StudySession[]
  codeSnippets  CodeSnippet[]
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  folder    String?
  tags      String[]
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  backlinks Note[]   @relation("NoteBacklinks")
  linksTo   Note[]   @relation("NoteBacklinks")
}

model Memory {
  id        String   @id @default(cuid())
  content   String   @db.Text
  embedding Float[]
  tags      String[]
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      String
  url       String
  content   String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  dueDate     DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
}

model Habit {
  id        String   @id @default(cuid())
  name      String
  streak    Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model StudySession {
  id        String   @id @default(cuid())
  subject   String
  duration  Int
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model CodeSnippet {
  id        String   @id @default(cuid())
  title     String
  language  String
  code      String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
